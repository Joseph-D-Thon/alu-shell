#!/bin/bash
python3 -c "exec('import os
def u(b):
 c=[]
 for k in b:
 if k not in c:
 c.append(k)
 return c
def d(s,b):
 c=u(b)
 m={x:i for i,x in enumerate(c)}
 v=0
 for k in s:
 v=v*len(c)+m[k]
 return v
def e(n,b):
 c=u(b)
 r=""
 while n>0:
 r=c[n%len(c)]+r
 n//=len(c)
 return r or c[0]
print(e(d(os.environ["WATER"],"water")+d(os.environ["STIR"],"stir."),"bestchol"))')"
