#!/bin/bash
python3 -c "exec('import os
def ub(b):
 u=[]
 for c in b:
 if c not in u:
 u.append(c)
 return u
def td(s,b):
 u=ub(b)
 m={c:i for i,c in enumerate(u)}
 v=0
 for ch in s:
 v=v*len(u)+m[ch]
 return v
def fd(n,b):
 u=ub(b)
 r=""
 while n>0:
 r=u[n%len(u)]+r
 n//=len(u)
 return r or u[0]
print(fd(td(os.environ["WATER"],"water")+td(os.environ["STIR"],"stir."),"bestchol"))')"
